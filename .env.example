# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
VITE_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── WhatsApp ──────────────────────────────────────────────────────────────────
VITE_WHATSAPP_NUMBER="254700709002"

# ── Backend server ────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL="http://localhost:5173"
ADMIN_PASSWORD="your-secure-password"

# JWT secret for customer sessions — use a long random string in production
JWT_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\""

# ── API base URL (frontend uses this to call the Express API) ─────────────────
VITE_API_URL="http://localhost:4000"

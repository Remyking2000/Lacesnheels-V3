# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.production and fill in all values before deploying.
# NEVER commit .env.production to version control.
#
# For VPS deployments, ensure all sensitive values are properly secured.
# Use strong, randomly generated values for secrets.
#

# ─────────────────────────────────────────────────────────────────────────────
# Node Environment
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV="production"

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
# For self-hosted PostgreSQL on VPS:
# DATABASE_URL="postgresql://lacesnheels:SECURE_PASSWORD@localhost:5432/lacesnheels?sslmode=require"
#
# For Neon (serverless):
# DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL="postgresql://lacesnheels:SECURE_PASSWORD@localhost:5432/lacesnheels?sslmode=require"
VITE_DATABASE_URL="postgresql://lacesnheels:SECURE_PASSWORD@localhost:5432/lacesnheels?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL="https://yourdomain.com"
VITE_API_URL="https://yourdomain.com/api"

# ─────────────────────────────────────────────────────────────────────────────
# Security - Secrets & Credentials
# ─────────────────────────────────────────────────────────────────────────────
# JWT Secret: Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="generate-a-long-random-string-64-characters-minimum"

# Admin Panel Password: Use a strong, secure password
ADMIN_PASSWORD="set-a-secure-admin-password"

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Get these from Google Cloud Console: https://console.cloud.google.com
# Redirect URI should point to your domain: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Customer support WhatsApp number (with country code)
VITE_WHATSAPP_NUMBER="254700709002"

# ─────────────────────────────────────────────────────────────────────────────
# Logging Configuration
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL="info"
LOG_FORMAT="json"

# ─────────────────────────────────────────────────────────────────────────────
# Error Tracking (Optional - Sentry)
# ─────────────────────────────────────────────────────────────────────────────
# Get this from https://sentry.io after creating a project
# SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring & Health Checks
# ─────────────────────────────────────────────────────────────────────────────
# Health check endpoint enabled: http://your-domain.com/health
ENABLE_HEALTH_CHECK=true

# ─────────────────────────────────────────────────────────────────────────────
# CORS Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Configure allowed origins (comma-separated)
# ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────────────────
# Requests per second for general endpoints
RATE_LIMIT_GENERAL=10
# Requests per second for API endpoints
RATE_LIMIT_API=30

# ─────────────────────────────────────────────────────────────────────────────
# Cache Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Cache assets for 30 days (in seconds)
ASSET_CACHE_MAX_AGE=2592000

# ─────────────────────────────────────────────────────────────────────────────
# Deployment Information
# ─────────────────────────────────────────────────────────────────────────────
DEPLOYMENT_ENV="vps"
DEPLOYMENT_REGION="your-region"
DEPLOYMENT_DATE="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
